# IntelliDocs AI Environment Configuration Template
# Duplicate this file to .env and customize as needed. Never commit .env.

# Application & Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 15/16 or SQLite for local dev/testing)
# PostgreSQL default: postgresql+psycopg://postgres:postgres@localhost:5432/intellidocs
# SQLite fallback default: sqlite+aiosqlite:///./backend/storage/intellidocs.db (or sqlite:///./backend/storage/intellidocs.db)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intellidocs

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_64_character_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload & Storage Settings
MAX_UPLOAD_MB=50
STORAGE_DIR=backend/storage

# OCR Settings
# Windows default path example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Hardware Acceleration (auto | cpu | cuda)
DEVICE=auto

# NLP & Machine Learning Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6
GENERATION_MODEL=google/flan-t5-base
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=false

# LLM Provider Configuration (local | gemini | openai)
LLM_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=
